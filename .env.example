# Copy to .env and fill in. Never commit real values.

# Discord webhook for the contact form. Server-side only: keep it without the
# NEXT_PUBLIC_ prefix, otherwise Next inlines it into the client bundle and the
# token becomes readable by anyone who opens the site.
# Consumed by src/app/api/contact/route.ts
DISCORD_HOOK_URL=https://discord.com/api/webhooks/000000000/replace-me

# Google Analytics measurement ID. Public by design; only rendered in production.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
